<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
	<Asset Type="Graphics:FontDescription">

		<FontName>DejaVu Sans</FontName>
		<Size>11</Size>
		<Spacing>0</Spacing>
		<UseKerning>true</UseKerning>
		<Style>Bold</Style>

		<CharacterRegions>
			<!-- Английский -->
			<CharacterRegion>
				<Start>&#32;</Start>
				<End>&#126;</End>
			</CharacterRegion>

			<!-- Русский -->
			<CharacterRegion>
				<Start>&#1040;</Start>
				<End>&#1103;</End>
			</CharacterRegion>

			<!-- Ё -->
			<CharacterRegion>
				<Start>&#1025;</Start>
				<End>&#1025;</End>
			</CharacterRegion>

			<!-- ё -->
			<CharacterRegion>
				<Start>&#1105;</Start>
				<End>&#1105;</End>
			</CharacterRegion>
		</CharacterRegions>

	</Asset>
</XnaContent>